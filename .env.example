# Optional: cp .env.example .env — see docs/INSTALL.md

CUDA_VISIBLE_DEVICES=0

# NF4 encoder (matbee)
LLM2VEC_QUANTIZE=nf4
LLM2VEC_LOCAL_BASE=/path/to/engineAI-studio-pro/models/kimodo-llm2vec-nf4
LLM2VEC_LOCAL_PEFT=/path/to/engineAI-studio-pro/models/kimodo-llm2vec-nf4/supervised_adapter

TEXT_ENCODER=llm2vec_nf4
TEXT_ENCODER_MODE=api
TEXT_ENCODER_URL=http://127.0.0.1:9550/
TEXT_ENCODER_DEVICE=cuda:0
TEXT_ENCODER_DTYPE=bfloat16
TEXT_ENCODER_QUANTIZATION=none

KIMODO_DEMO_MODEL=Kimodo-SMPLX-RP-v1
KIMODO_T800=1
# GMR ik_safety_break (no effect on jitter; kept for compatibility).
KIMODO_T800_IK_SAFETY=1
# Temporal smoothing of T800 qpos after retarget — removes standing IK ping-pong. Set 0 to disable.
KIMODO_T800_SMOOTH=1
KIMODO_T800_SMOOTH_WINDOW=13
# Solve IK every Nth frame + interpolate (1 = every frame). >1 is faster but softens fast motion.
KIMODO_T800_IK_STRIDE=1
# Experimental: parallel retarget across samples via CPU processes. 0/1 = sequential. >=2 to opt in.
KIMODO_T800_RETARGET_WORKERS=0
# Multi-sample: show all humans at once; full skin cache in background (0 = old sequential blocking).
KIMODO_DEFER_SKIN_PRECOMPUTE=1
# Multi-sample T800: reveal all robots together after IK (0 = show each robot as soon as its IK finishes).
KIMODO_T800_SYNC_ATTACH=1
# EngineAI sky branding N/E/S/W (far from stage; PNG alpha preserved).
KIMODO_HORIZON_LOGO=1
KIMODO_HORIZON_LOGO_DISTANCE=55
KIMODO_HORIZON_LOGO_ELEVATION_DEG=11
# KIMODO_HORIZON_LOGO_HEIGHT=10
KIMODO_HORIZON_LOGO_SIZE=6
# RTX 50xx/Blackwell: TF32 fast matmul (set 0 to force strict fp32).
KIMODO_FAST_MATMUL=1
